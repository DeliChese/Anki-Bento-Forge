{
  "name": "Bento Forge",
  "package": "bento_forge",
  "version": "18.1.0",
  "human_version": "18.1.0",
  "min_point_version": 50,
  "max_point_version": 260500,
  "description": "Bento Forge — Language card factory and dockable AI Study Sessions companion for Anki, with safe preview/import, optional TTS, and interactive learning templates.",
  "author": "AnkiTool Team / Bento Station AIOS",
  "license": "MIT",
  "anki": {
    "min_version": "2.1.50",
    "max_version": "26.5"
  },
  "keywords": ["japanese", "chinese", "korean", "english", "vocabulary", "ai", "tts", "language-learning"],
  "categories": ["learning", "import", "templates"],
  "dependencies": {
    "python": ">=3.9",
    "packages": ["edge-tts", "gtts"]
  },
  "config": {
    "learning_modes": ["language"],
    "ai_providers": ["openai", "deepseek", "ollama", "lmstudio", "openrouter"],
    "languages": ["japanese", "chinese", "korean", "english"],
    "tts_engines": ["edge-tts", "melo-tts-local", "gtts", "voicevox"],
    "template_count": 5,
    "default_cards_per_note": 1,
    "srs_layouts": ["combo", "independent"],
    "study_modes": ["qa", "vn", "wb", "pron", "lg"]
  },
  "entry_point": "start_smart_factory",
  "shortcut": "Ctrl+Shift+I"
}
